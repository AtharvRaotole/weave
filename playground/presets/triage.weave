# Two reads at the same time, a bit of plain Python, then one post
# to Slack. The post can't be undone, so it waits for the reads.
repo = "AtharvRaotole/weave"
open_issues = gh_issues(repo, state="open")
closed = gh_issues(repo, state="closed")

labels = {}
for issue in open_issues:
    labels[issue["label"]] = labels.get(issue["label"], 0) + 1

summary = f"{len(open_issues)} open, {len(closed)} closed. labels: {labels}"
print(summary)
post_slack("#weave-triage", summary)
